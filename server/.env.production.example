# Production backend env — copy the keys into your host's dashboard
# (Render / Railway / Fly). Do NOT commit a filled-in copy: real secrets
# stay in the host's env-var store only.

HOST=0.0.0.0
# PORT is provided by the host automatically — do not set it.

# Generate long random strings, e.g.  node -e "console.log(crypto.randomBytes(48).toString('hex'))"
JWT_SECRET=
SESSION_SECRET=

# Your deployed frontend origin, for CORS. No trailing slash.
CLIENT_ORIGIN=https://farmtrust.vercel.app

DB_PATH=./farmtrust.db

# Heavy Python workers off for a lightweight demo host.
OCR_ENABLED=false
AI_DETECTOR_ENABLED=false

# Google OAuth / Stripe stay blank -> app runs fully without them
# (email login uses on-screen dev codes; checkout auto-marks orders paid).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
STRIPE_SECRET_KEY=
