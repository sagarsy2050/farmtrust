# --- Core (local-only: server binds to 127.0.0.1, never the network) ---
HOST=127.0.0.1
PORT=3001
JWT_SECRET=change_this_to_a_long_random_string
CLIENT_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads
DB_PATH=./farmtrust.db

# --- Email (optional, leave blank to disable) ---
# Leave unset/blank and OTP/password-reset codes are never emailed — they're
# logged server-side AND returned in the API response's dev_otp/
# dev_reset_token fields so the local UI can show them directly. No SMTP
# sending is actually implemented yet; setting this alone does nothing.
SMTP_HOST=

# --- Google OAuth (optional, leave blank to disable) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback
SESSION_SECRET=change_this_too

# --- Stripe (optional) ---
# Leave unset/blank to run fully offline: checkout auto-marks orders "paid"
# locally with no network call at all. Set a real sk_test_/sk_live_ key here
# only if you actually want Stripe involved.
STRIPE_SECRET_KEY=
STRIPE_VERSION=2025-10-29.clover

# --- Python OCR worker ---
PYTHON_BIN=uv
OCR_WORKER_DIR=../python-ocr
OCR_ENABLED=true

# --- AI-generated-image detector (guyfloki/ai-image-detector, CvT-13) ---
# Flags uploaded document photos that look AI-generated. Runs alongside OCR
# on image uploads (not PDFs). First run needs network access once to fetch
# the microsoft/cvt-13 base config via transformers (cached after that); the
# trained weights themselves are local at ../model/model_epoch_24.pth.
AI_DETECTOR_ENABLED=true
AI_DETECTOR_WORKER_DIR=../ai-image-detector
AI_DETECTOR_WEIGHTS_DIR=../model

# --- Bootstrap admin (created on first boot if no admin exists) ---
ADMIN_EMAIL=admin@farmtrust.local
ADMIN_PASSWORD=ChangeMe123!

# --- Live market prices (optional) ---
# Leave blank to serve local sample market-price data (default, no network
# calls). A real AGMARKNET/data.gov.in integration is not implemented yet —
# see server/src/market/ingest.js for what setting this would require.
AGMARKNET_API_KEY=
